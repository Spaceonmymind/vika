################################################################################
# Базовые настройки приложения
################################################################################
ENV_FILE=../.env

APP_NAME=Vika
# local, staging, production
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Имя хоста, например: vi.example.ru
PROJECT_HOST=vi.local
APP_URL="https://${PROJECT_HOST}"
# true, если трафик приходит на 80, но ссылки/редиректы должны быть https
APP_FORCE_HTTPS=false

APP_TIMEZONE='Asia/Yekaterinburg'
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

################################################################################
# Логирование и отладка
################################################################################
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_STDERR_FORMATTER="Monolog\\Formatter\\JsonFormatter"

################################################################################
# База данных
################################################################################
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=vika
DB_USERNAME=
DB_PASSWORD=

################################################################################
# Сессии и кэш
################################################################################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX="vika_cache_"

################################################################################
# Очереди и события
################################################################################
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
HORIZON_DOMAIN="${PROJECT_HOST}"

################################################################################
# Файловое хранилище
################################################################################
FILESYSTEM_DISK=local

################################################################################
# Redis
################################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

################################################################################
# Почта
################################################################################
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MSMTP_ACCOUNT=default

################################################################################
# Reverb
################################################################################
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=nginx
REVERB_PORT=80
REVERB_SCHEME=http

################################################################################
# Frontend (Vite)
################################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${PROJECT_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
#Режим работы логов в интерфейсе
VITE_DEBUG_MODE=false

################################################################################
# Документация
################################################################################
# Автогенерация документации при обращении к веб интерфейсу документации. True только для локальной разработки
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
L5_SWAGGER_GENERATE_YAML_COPY=true

################################################################################
# Мониторинг и метрики
################################################################################
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

################################################################################
# Идемпотентность API
################################################################################
IDEMPOTENCY_ENABLED=true

################################################################################
# Внешние сервисы (заполнить при необходимости)
################################################################################
ESIA_LOGIN_URL=
ESIA_VALIDATE_TICKET_URL=
ESIA_LOGOUT_URL=
ESIA_CALLBACK_REDIRECT_URL=

MAX_API_TOKEN=
MAX_WEB_APP_BASE_URL=

HUMANITARIAN_POINTS_URL=
HUMANITARIAN_POINTS_LOGIN=
HUMANITARIAN_POINTS_PASSWORD=

TOLYA_INTENT_QUALIFIER_BASE_URL=

# Данные для подключения к РРП
RRP_BASE_URL=
RRP_LOGIN=
RRP_PASSWORD=

# Данные для подключения к ФЭР
FER_BASE_URL=
FER_LOGIN=
FER_PASSWORD=

# Данные для подключения к ВИЛАР
VILAR_BASE_URL=
VILAR_API_TOKEN=
VILAR_TELEMED_CONSULTATIONS_ENDPOINT=

# Данные для подключения к Яндекс.Телемост
TELEMOST_BASE_URL=https://cloud-api.yandex.net/v1/telemost-api
TELEMOST_TOKEN=

# Данные для подключения к системе записи на прием
BOOKING_BASE_URL=

# Данные для отправки сведений об актировках на admhmansy
ADMHMANSY_WEATHER_API_URL=
ADMHMANSY_WEATHER_API_TOKEN=

# Данные для отправки сведений об актировках на gosuslugi86
GOSUSLUGI86_WEATHER_MOBILE_APP_API_URL=

# Данные для получения погодных данных с Юграметео
#UGRAMETEO_WEATHER_API_URL=http://host.docker.internal:3080/rest/product
UGRAMETEO_WEATHER_API_URL=http://ugrameteo.ru/rest/product
UGRAMETEO_WEATHER_API_LOGIN=
UGRAMETEO_WEATHER_API_PASSWORD=

# Размер чанка пользователей для отправки уведомлений об актировках
ACTIROVKI_USERS_CHUNK_SIZE_FOR_SENDING_NOTIFICATIONS=50

# Адрес для получения данных по расписанию
TIMETABLE_TIMESHEET_URL=
# Адрес для получения данных об организациях
TIMETABLE_ORGANISATIONS_URL=

################################################################################
# LLM и векторный поиск
################################################################################
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=vectorstore
POSTGRES_HOST=vikasearch-db
DATABASE_URL="postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:5432/vectorstore"
LLM__GIGACHAT_ACCESS_TOKEN=

################################################################################
# Контейнеры и инфраструктура
################################################################################
COMPOSE_PROJECT_NAME=vika-production
COMPOSE_COMMON_PROJECT_NAME=vi-common
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker/docker-compose.production.yml:docker/docker-compose.production.local-volumes.yml
COMPOSE_HTTP_TIMEOUT=120
COMPOSE_NETWORK_NAME=vi

COMPOSER_HOME=./composer
COMPOSER_CACHE_DIR="$COMPOSER_HOME/cache"

SERVER_TIMEZONE="${APP_TIMEZONE}"
PHP_TIMEZONE="${APP_TIMEZONE}"

# Теги образов
IMAGE_TAG_PHP=vika/php-fpm:local
IMAGE_TAG_NGINX=nginx:1.29-otel
IMAGE_TAG_VIKASEARCH=vika/vikasearch:local

################################################################################
# SSL и редиректы
################################################################################
# Резолвер для сертификатов, варианты: letsEncrypt или пусто
PROJECT_CERT_RESOLVER=

# Обработчики (middlewares), возможные значения (можно комбинировать через запятую):
# basic-auth - включение basic-авторизации (пароль задается в TRAEFIK_BASIC_AUTH_USERS)
# redirect-to-non-www@file - редирект с www на без www (схема https)
# redirect-to-www@file - редирект на www (схема https)
# redirect-to-non-www-http@file - редирект с www на без www (схема http, то есть если не надо делать редирект сразу на https)
# redirect-to-www-http@file - редирект на www (схема http)
# redirect-to-https@file - редирект с http на https
# trim-index@file - обрезает index.php, index.html
PROJECT_SSL_MIDDLEWARES=redirect-to-non-www@file,trim-index@file
PROJECT_MIDDLEWARES=redirect-to-non-www-http@file,trim-index@file

# Токен приема обращений от бота «СтопГраффити»
STOP_GRAFFITI_INTEGRATION_TOKEN=
STOP_GRAFFITI_BOT_CALLBACK_URL=
STOP_GRAFFITI_BOT_CALLBACK_TOKEN=
STOP_GRAFFITI_MEDIA_ALLOWED_HOSTS=i.oneme.ru

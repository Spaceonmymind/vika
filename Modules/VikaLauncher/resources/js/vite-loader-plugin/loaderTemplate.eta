(async function() {
  const manifest = <%~ it.manifestJson %>;

  const loadCss = (href) => {
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = href;
    document.head.appendChild(link);
  };

  const loadJs = (src) => {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.type = 'module';
      script.onload = resolve;
      script.onerror = reject;
      document.body.appendChild(script);
    });
  };

  (manifest.css || []).forEach(css => loadCss('<%= it.publicPath %>' + css));
  await loadJs('<%= it.publicPath %>' + manifest.file);
})();

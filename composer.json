{
  "name": "ugraphic/vika",
  "type": "project",
  "description": "vi.admhmao.ru submodule",
  "require": {
    "php": "^8.3",
    "ext-soap": "*",
    "darkaonline/l5-swagger": "^9.0",
    "fedeisas/laravel-mail-css-inliner": "^5.4",
    "flowgistics/laravel-xml": "^1.1",
    "infinitypaul/idempotency-laravel": "^1.0",
    "keepsuit/laravel-opentelemetry": "*",
    "lab404/laravel-impersonate": "^1.7",
    "laravel/framework": "^v12.8.1",
    "laravel/horizon": "^5.31",
    "laravel/reverb": "^1.4",
    "laravel/sanctum": "^4.0",
    "laravel/scout": "^10.12",
    "laravel/tinker": "^2.10",
    "maatwebsite/excel": "^3.1",
    "nwidart/laravel-modules": "^v12.0.1",
    "orangehill/iseed": "^3.0",
    "spatie/image-optimizer": "^1.8",
    "spatie/laravel-permission": "^6.17",
    "spatie/laravel-query-builder": "^6.3",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.3",
      "laravel/boost": "^1.4",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.13",
    "laravel/telescope": "^5.7",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.1",
    "pestphp/pest": "^3.6",
    "pestphp/pest-plugin-laravel": "^3.0",
    "reliese/laravel": "^1.4",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    },
    "merge-plugin": {
      "include": [
        "Modules/*/composer.json"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "tbachert/spi": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
